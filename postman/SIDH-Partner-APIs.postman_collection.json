                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "{{sidhAccessToken}}",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{sidhCookie}}",
                "type": "text"
              },
              {
                "key": "x-csrf-token",
                "value": "{{sidhCsrfToken}}",
                "type": "text"
              }
            ],
