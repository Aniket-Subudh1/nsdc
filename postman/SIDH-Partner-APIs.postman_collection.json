            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"Yoga B1 FY 26-27\",\n  \"size\": 1,\n  \"batchStartDate\": \"2026-07-22T00:00:00Z\",\n  \"batchEndDate\": \"2026-07-28T00:00:00Z\",\n  \"courseId\": \"FeeSchCor_67556\",\n  \"trainingHoursPerDay\": 8,\n  \"batchStartTime\": \"2026-07-22T09:00:00Z\",\n  \"batchEndTime\": \"2026-07-28T17:00:00Z\",\n  \"batchFee\": {\n    \"totalFees\": 500\n  },\n  \"feePaidBy\": \"Self-Paid\",\n  \"assessmentStartDate\": \"2026-07-29T00:00:00Z\",\n  \"assessmentEndDate\": \"2026-07-29T00:00:00Z\",\n  \"assessmentMode\": \"Self\",\n  \"batchType\": \"Regular\",\n  \"type\": \"Fee Based\",\n  \"skillingcategory\": {\n    \"name\": \"NSDC Market led programme\",\n    \"id\": 1,\n    \"scheme\": \"Fee Based\"\n  },\n  \"schemeId\": \"Scheme_2\",\n  \"schemeReferenceId\": \"Scheme_2\",\n  \"schemeType\": \"feeBased\",\n  \"tcId\": \"1330\",\n  \"tpId\": \"TP38273\",\n  \"createdSource\": \"Created for NSDC Academy Partners\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{sidhBaseUrl}}/api/batch/v1/create",
            "description": "Built via `buildSidhBatchPayload` from MongoDB batch `bat_015486ccb1d84928` (`Yoga B1 FY 26-27`). Production currently returns 403 if Batch Creation is not enabled for this TP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const body = pm.response.json();",
                  "  const batchId = body.batchId || body.batchID || (body.data && body.data.batchId);",
                  "  if (batchId) {",
                  "    pm.collectionVariables.set('sidhBatchId', String(batchId));",
                  "    pm.environment.set('sidhBatchId', String(batchId));",
                  "  }",
                  "} catch (error) {}"
                ]
              }
            }
          ],
          "response": []
        },
        {
